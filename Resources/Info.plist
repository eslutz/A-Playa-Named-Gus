<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>Gus</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- gus:// deep links: fixed app destinations used by the tvOS Top Shelf
	     extension, menu commands, and screenshot automation (see AppRoute). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.ericslutz.gus</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>gus</string>
			</array>
		</dict>
	</array>

	<!-- Handoff: continue browsing an item or playback on another device.
	     Payloads carry item/server/user ids only — never tokens (UserActivities.swift). -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>dev.ericslutz.gus.item-detail</string>
		<string>dev.ericslutz.gus.playback</string>
	</array>

	<!-- Export-compliance: no non-exempt encryption. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Self-hosted Jellyfin servers are frequently plain HTTP on a LAN, so local
	     networking is exempt from ATS. Remote servers must use TLS; connect tries
	     https first for schemeless addresses (see AppModel.connect). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- User-initiated Jellyfin server discovery on the local network. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>A Playa Named Gus can find Jellyfin servers on your local network when you choose Find Local Servers.</string>

	<!-- iOS/tvOS background audio + Picture in Picture. Ignored on macOS. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- Required for visionOS ImmersiveSpace presentation alongside the main window.
	     The CarPlay template scene is declared here but only activates when the app
	     carries the Apple-granted carplay-audio entitlement (Config/Gus-CarPlay.entitlements). -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>CPTemplateApplicationSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>GusCarPlay</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).GusCarPlaySceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- macOS minimum system version (empty/ignored on other SDKs). -->
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
</dict>
</plist>
