#!/usr/bin/env python3
"""Run the official CLI with the installed Apple fonts available to file mode."""
import os
import pathlib
import sys

folder = pathlib.Path(__file__).resolve().parent
root = pathlib.Path(os.environ.get('GUS_OPENPENCIL_CLI_ROOT', '/private/tmp/gus-openpencil-cli'))
entry = root/'node_modules/@open-pencil/cli/bin/openpencil.js'
if not entry.exists():
    sys.exit('Install the CLI first: npm install --prefix /private/tmp/gus-openpencil-cli @open-pencil/cli@0.16.0')
os.execvp('node', ['node', '--import', str(folder/'cli-fonts.mjs'), str(entry), *sys.argv[1:]])
