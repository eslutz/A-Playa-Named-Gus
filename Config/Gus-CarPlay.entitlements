<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CarPlay audio app entitlement. NOT wired into Shared.xcconfig yet: Apple must
	     grant com.apple.developer.carplay-audio to the Team before archives can carry
	     it. Once granted, add to Shared.xcconfig:
	       CODE_SIGN_ENTITLEMENTS[sdk=iphoneos*] = Config/Gus-CarPlay.entitlements
	       CODE_SIGN_ENTITLEMENTS[sdk=iphonesimulator*] = Config/Gus-CarPlay.entitlements
	     See Documentation/AppStore/signing-capabilities.md. -->
	<key>com.apple.developer.carplay-audio</key>
	<true/>
</dict>
</plist>
