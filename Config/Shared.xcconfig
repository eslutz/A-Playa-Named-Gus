// Shared.xcconfig — A Playa Named Gus build settings (source of truth for the target).
// Per-SDK divergence is expressed with [sdk=...] conditional assignments.

// MARK: - Identity & versioning

PRODUCT_NAME = A Playa Named Gus
PRODUCT_MODULE_NAME = Gus
PRODUCT_BUNDLE_IDENTIFIER = dev.ericslutz.gus
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// MARK: - Swift

// Swift 5 language mode for the first milestone: all modern APIs (@Observable,
// NavigationStack, glass) are availability-gated, not language-mode-gated, so we
// keep them while avoiding strict-concurrency churn against the Jellyfin SDK.
SWIFT_VERSION = 5
SWIFT_STRICT_CONCURRENCY = minimal
SWIFT_EMIT_LOC_STRINGS = YES
ENABLE_PREVIEWS = YES

// MARK: - Info.plist (provided, not generated)

GENERATE_INFOPLIST_FILE = NO

// MARK: - Asset catalog

ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// MARK: - Devices / platforms

// 1 = iPhone, 2 = iPad, 3 = Apple TV, 7 = Apple Vision. macOS ignores this.
TARGETED_DEVICE_FAMILY = 1,2,3,7
SUPPORTS_MACCATALYST = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO

// MARK: - Code signing
//
// Default GitHub/local CI signing: ad-hoc sign so simulator + native macOS
// builds succeed without provisioning profiles. The Team ID is not secret and
// is committed so generated projects have the paid Apple Developer Program team
// selected for Xcode Cloud and local device-signing setup.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM = QS3GC3CT43
CODE_SIGNING_REQUIRED = NO
CODE_SIGNING_ALLOWED = YES

// Sandbox + outbound network only on macOS (network.client/app-sandbox are
// macOS-sandbox entitlements). macOS app state remains per OS login account via
// the user-domain sandbox container, UserDefaults, Application Support, and Keychain.
CODE_SIGN_ENTITLEMENTS[sdk=macosx*] = Config/Gus.entitlements

// Native SharePlay / Group Activities.
CODE_SIGN_ENTITLEMENTS[sdk=iphoneos*] = Config/Gus-SharePlay.entitlements
CODE_SIGN_ENTITLEMENTS[sdk=iphonesimulator*] = Config/Gus-SharePlay.entitlements
CODE_SIGN_ENTITLEMENTS[sdk=xros*] = Config/Gus-SharePlay.entitlements
CODE_SIGN_ENTITLEMENTS[sdk=xrsimulator*] = Config/Gus-SharePlay.entitlements

// tvOS runs A Playa Named Gus as the current Apple TV profile so each profile gets
// separate app storage and Keychain items. The app intentionally does not use
// kSecUseUserIndependentKeychain for Jellyfin access tokens.
CODE_SIGN_ENTITLEMENTS[sdk=appletvos*] = Config/Gus-tvOS.entitlements
CODE_SIGN_ENTITLEMENTS[sdk=appletvsimulator*] = Config/Gus-tvOS.entitlements

// MARK: - Local overrides
//
// Keep this last so local and Xcode Cloud generated overrides can opt into
// automatic signing without changing the source-controlled PR-build defaults.
#include? "Local.xcconfig"
