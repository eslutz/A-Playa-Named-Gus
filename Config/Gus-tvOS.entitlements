<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- tvOS only: run the app as the current Apple TV profile. The entitlement
	     value permits using the user-independent keychain, but A Playa Named Gus deliberately
	     keeps Jellyfin tokens in the current profile's normal Keychain scope. -->
	<key>com.apple.developer.user-management</key>
	<array>
		<string>runs-as-current-user-with-user-independent-keychain</string>
	</array>

	<!-- Shared container for the Top Shelf snapshot (TopShelfSnapshot.swift): the app
	     writes Continue Watching data, the GusTopShelf extension reads it. No
	     credentials cross this boundary. Register the group with the App ID before
	     device/archive signing (see Documentation/AppStore/signing-capabilities.md). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.ericslutz.gus</string>
	</array>

	<!-- Native SharePlay / Group Activities support. -->
	<key>com.apple.developer.group-session</key>
	<true/>
</dict>
</plist>
