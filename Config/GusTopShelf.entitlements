<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Read-only consumer of the Top Shelf snapshot the app writes into the shared
	     container — see TopShelfSnapshot.swift and Gus-tvOS.entitlements. -->
