<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links power web handoff on platforms that do not use the
	     Declared Age Range entitlement file. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:gus.ericslutz.dev</string>
	</array>

	<!-- Native SharePlay / Group Activities support. The activity payload carries
	     item identifiers and display metadata only, never Jellyfin tokens or stream URLs. -->
	<key>com.apple.developer.group-session</key>
	<true/>

	<key>com.apple.developer.icloud-container-identifiers</key>
	<array><string>iCloud.dev.ericslutz.gus</string></array>
	<key>com.apple.developer.icloud-services</key>
	<array><string>CloudKit</string></array>

	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
