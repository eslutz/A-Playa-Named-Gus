<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- macOS only: sandbox the app and allow outbound network connections
	     (so it can reach a self-hosted Jellyfin server). -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Jellyfin discovery binds an ephemeral UDP socket to receive replies. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:gus.ericslutz.dev</string>
	</array>
	<key>com.apple.developer.declared-age-range</key>
	<true/>
	<key>com.apple.developer.group-session</key>
	<true/>
</dict>
</plist>
